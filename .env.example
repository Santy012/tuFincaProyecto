# Copiar como .env y completar con valores propios
DB_NAME=tuFinca
DB_USER=tufinca
DB_PASSWORD=
DB_ROOT_PASSWORD=
JWT_SECRET=
JWT_EXPIRATION=3600000
# Dominio desde el que el navegador llama a la API (CORS). En local se deja así;
# en producción, el dominio del sitio, por ejemplo https://tufincainmobiliaria.com
FRONTEND_URL=http://localhost:8081
